# Postgres — provision a free Neon project (https://neon.tech) and paste its connection string.
DATABASE_URL=postgresql+psycopg://user:password@host/dbname

# LLM provider — every option below is OpenAI-compatible; only these three
# values change to switch providers, nothing in the code does. Uncomment
# ONE block and fill in its key/URL, leave the rest commented out.
#
# This tool never sends a dataset itself to the LLM — only the
# plain-language answers and free-text notes a person types into the
# assessment (see backend/fixtures/synthetic_datasets.py and
# docs/DECISIONS.md's Checkpoint 3 note on why real ACE/TASO data is kept
# out of this entirely). That's what makes a publicly hosted provider a
# reasonable default here, not just a self-hosted one.

# OpenRouter (recommended default) — a hosted gateway to many providers'
# models behind one API key (get one at https://openrouter.ai/keys). Its
# "auto router" picks a good model per request for you instead of you
# naming one — set LLM_MODEL to openrouter/auto for that (free to use as
# of this writing, 2M token context: https://openrouter.ai/openrouter/auto).
# Name a specific model instead (e.g. anthropic/claude-3.5-sonnet,
# openai/gpt-4o-mini) if you'd rather pick than auto-route.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/auto
LLM_API_KEY=sk-or-v1-your-key-here

# Ollama — fully local and free, no API key or internet needed once a
# model is pulled. Good for trying this out at zero cost, or offline.
# Install from https://ollama.com, then `ollama pull llama3.1:8b`.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b
# LLM_API_KEY=ollama

# vLLM — self-hosted on your own GPU infra. The block below is ACE's own
# pilot deployment specifically; it is not reachable outside ACE's
# network, so leave it commented out unless you're standing up your own
# vLLM box.
# LLM_BASE_URL=http://10.35.50.41:8000/v1
# LLM_MODEL=ibnzterrell/Meta-Llama-3.3-70B-Instruct-AWQ-INT4
# LLM_API_KEY=not-needed

# Any other OpenAI-compatible endpoint (Together AI, Groq, Azure OpenAI,
# the OpenAI API itself, etc.) works the same way — set these three
# values to whatever that provider's own docs give you.

# CORS — the Next.js dev server origin
FRONTEND_ORIGIN=http://localhost:3000

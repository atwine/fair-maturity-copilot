# Postgres — provision a free Neon project (https://neon.tech) and paste its connection string.
DATABASE_URL=postgresql+psycopg://user:password@host/dbname

# LLM provider — both endpoints below are OpenAI-compatible; only these three
# values change to switch providers, nothing in the code does.
#
# vLLM (dedicated A100 infra, the actual production target, and faster in
# practice than local Ollama on this hardware — default for dev AND pilot):
LLM_BASE_URL=http://10.35.50.41:8000/v1
LLM_MODEL=ibnzterrell/Meta-Llama-3.3-70B-Instruct-AWQ-INT4
LLM_API_KEY=not-needed
#
# Local Ollama (offline fallback only — use if the vLLM box is ever
# unreachable, not for routine dev):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b
# LLM_API_KEY=ollama

# CORS — the Next.js dev server origin
FRONTEND_ORIGIN=http://localhost:3000
